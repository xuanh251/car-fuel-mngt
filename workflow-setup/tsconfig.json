{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx"
  },
  "include": ["server/**/*.ts", "web/src/**/*.ts", "web/src/**/*.tsx", "vite.config.ts"]
}
